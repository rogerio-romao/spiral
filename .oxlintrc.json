{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["eslint", "oxc", "unicorn", "import", "jsdoc", "node", "promise", "vitest"],
    "categories": {
        "correctness": "error",
        "suspicious": "error",
        "pedantic": "warn",
        "perf": "error",
        "style": "warn",
        "restriction": "warn",
        "nursery": "warn"
    },
    "rules": {
        "eslint/no-unused-expressions": [
            "error",
            {
                "allowTernary": true
            }
        ],
        "eslint/max-lines-per-function": ["warn", 450],
        "eslint/max-statements": ["warn", 130],
        "eslint/max-lines": ["warn", 730],
        "eslint/max-params": ["warn", 5],
        "eslint/max-classes-per-file": ["warn", 6],
        "eslint/no-magic-numbers": "off",
        "eslint/no-ternary": "off",
        "eslint/no-continue": "off",
        "eslint/id-length": [
            "warn",
            {
                "min": 2,
                "exceptions": [
                    "a",
                    "b",
                    "e",
                    "g",
                    "h",
                    "i",
                    "j",
                    "k",
                    "r",
                    "t",
                    "x",
                    "y",
                    "w",
                    "z",
                    "_"
                ]
            }
        ],
        "eslint/no-multi-assign": "off",
        "eslint/no-plusplus": ["warn", { "allowForLoopAfterthoughts": true }],
        "eslint/class-methods-use-this": "off",
        "eslint/capitalized-comments": "off",
        "eslint/complexity": ["warn", 33],
        "eslint/func-style": ["error", "declaration"],
        "eslint/sort-imports": "off",
        "eslint/no-extend-native": "off",
        "eslint/sort-keys": ["warn", "asc", { "caseSensitive": false }],
        "eslint/no-promise-executor-return": "off",
        "promise/avoid-new": "off",
        "oxc/no-optional-chaining": "off",
        "oxc/no-async-await": "off",
        "oxc/no-rest-spread-properties": "off",
        "unicorn/filename-case": [
            "error",
            {
                "cases": {
                    "camelCase": true,
                    "pascalCase": true
                }
            }
        ],
        "unicorn/no-null": "off",
        "import/no-default-export": "off",
        "import/no-nodejs-modules": "off",
        "import/unambiguous": "off",
        "import/no-commonjs": "off",
        "import/no-relative-parent-imports": "off",
        "import/no-named-export": "off",
        "import/group-exports": "off",
        "node/no-process-env": ["warn", { "allowedVariables": ["NODE_ENV"] }],
        "vitest/require-hook": "off",
        "vitest/prefer-called-times": "off",
        "vitest/no-hooks": "off",
        "vitest/max-expects": ["warn", { "max": 6 }]
    },
    "settings": {
        "jsx-a11y": {
            "polymorphicPropName": null,
            "components": {},
            "attributes": {}
        },
        "next": {
            "rootDir": []
        },
        "react": {
            "formComponents": [],
            "linkComponents": [],
            "version": null,
            "componentWrapperFunctions": []
        },
        "jsdoc": {
            "ignorePrivate": false,
            "ignoreInternal": false,
            "ignoreReplacesDocs": true,
            "overrideReplacesDocs": true,
            "augmentsExtendsReplacesDocs": false,
            "implementsReplacesDocs": false,
            "exemptDestructuredRootsFromChecks": false,
            "tagNamePreference": {}
        },
        "vitest": {
            "typecheck": false
        }
    },
    "env": {
        "browser": true,
        "node": true,
        "vitest": true
    },
    "ignorePatterns": ["*.d.ts"]
}
